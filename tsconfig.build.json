{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.fixtures/**", "src/cli/verbs/test-support.ts", "src/**/*.test-support.ts", "src/retire-test-support.ts", "src/offline-suite-consistency.ts"]
}
